# Database
DB_NAME=cadastro_clientes
DB_USER=postgres
DB_PASSWORD=postgres
DB_URL="postgresql://${DB_USER}:${DB_PASSWORD}@cadastro-clientes-db-1:5432/${DB_NAME}"

# Front-end
VITE_API_BASE_URL=/api/v1
VITE_API_CUSTOMERS_PATH=/customers
VITE_API_DELETED_CUSTOMERS_PATH=/customers/deleted
VITE_API_CUSTOMER_RESTORE_PATH=/customers/restore
VITE_API_CUSTOMER_PERMANENT_DELETE_PATH=/customers/permanent
API_PROXY_PREFIX=/api
API_PROXY_TARGET=api:3333
VITE_API_PROXY_TARGET=http://localhost:3333

# API
CORS_ORIGIN=web:8080
JWT_SECRET=abcdefghijklmnopqrstuvwxyz123456
NODE_ENV=production # or development
SEED_USER_PASSWORD=12345678

# Observability
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=12345678
