// use prisma-8

enum PersonType {
    INDIVIDUAL
    COMPANY
    @@type("pg/text@1")
}

model Customers {
    id         String        @id @default(uuid()) @unique @map("id")
    personType PersonType    @map("person_type")
    document   VarChar(14)   @unique @map("document")
    name       VarChar(150)  @map("name")
    tradeName  VarChar(150)? @map("trade_name")
    birthDate  Date?         @map("birth_date")
    email      VarChar(254)? @map("email") @unique
    phone      VarChar(11)   @map("phone")
    createdAt  DateTime      @default(now()) @map("created_at")
    updatedAt  DateTime?     @map("updated_at")
    deletedAt  DateTime?     @map("deleted_at")

    @@map("customers")
}

model Addresses {
    id         String       @id @default(uuid()) @unique @map("id")
    customerId String       @relation(id: Customers) @unique @map("customer_id")
    zipCode    VarChar(8)   @map("zip_code")
    street     VarChar(150) @map("street")
    number     VarChar(10)? @default("S/N") @map("number")
    complement VarChar(100) @map("complement")
    district   VarChar(100) @map("district")
    city       VarChar(100) @map("city")
    state      VarChar(2)   @map("state")

    @@map("addresses")
}