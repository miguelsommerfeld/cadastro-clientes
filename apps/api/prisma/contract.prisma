// use prisma-8

enum PersonType {
    INDIVIDUAL
    COMPANY
    @@type("pg/text@1")
}

model Customers {
    id         String        @id @default(uuid()) @unique @map("id")
    personType PersonType    @map("person_type")
    document   PersonType    @unique @map("document")
    name       VarChar(150)  @map("name")
    tradeName  VarChar(150)? @map("trade_name")
    birthDate  DateTime?     @map("birth_date")
    email      VarChar(254)? @map("email")
    phone      VarChar(11)   @map("phone")
    createdAt  DateTime      @default(now()) @map("created_at")
    updatedAt  DateTime      @map("updated_at")
    deletedAt  DateTime?     @map("deleted_at")

    @@map("customers")
}