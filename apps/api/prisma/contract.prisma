// use prisma-8

enum PersonType {
    INDIVIDUAL
    COMPANY
    @@type("pg/text@1")
}

enum Role {
    ADMIN
    OPERATOR
    VIEWER
    @@type("pg/text@1")
}

model Customers {
    id         String        @id @default(uuid()) @unique @map("id")
    tenantId   String        @relation(id: Tenants) @map("tenant_id")
    personType PersonType    @map("person_type")
    document   VarChar(14)   @map("document")
    name       VarChar(150)  @map("name")
    tradeName  VarChar(150)? @map("trade_name")
    birthDate  Date?         @map("birth_date")
    email      VarChar(254)? @map("email") @unique
    phone      VarChar(11)   @map("phone")
    createdAt  DateTime      @default(now()) @map("created_at")
    updatedAt  DateTime?     @map("updated_at")
    deletedAt  DateTime?     @map("deleted_at")

    @@unique([tenantId, document])
    @@index([tenantId])
    @@map("customers")
}

model Addresses {
    id         String        @id @default(uuid()) @unique @map("id")
    customerId String        @relation(id: Customers) @unique @map("customer_id")
    zipCode    VarChar(8)    @map("zip_code")
    street     VarChar(150)  @map("street")
    number     VarChar(10)   @default("S/N") @map("number")
    complement VarChar(100)? @map("complement")
    district   VarChar(100)  @map("district")
    city       VarChar(100)  @map("city")
    state      VarChar(2)    @map("state")

    @@map("addresses")
}

model Users {
    id           String       @unique @map("id")
    tenantId     String       @relation(id: Tenants) @map("tenant_id")
    role         Role         @map("role")
    name         VarChar(100) @map("name")
    email        VarChar(254) @unique @map("email")
    passwordHash VarChar(253) @map("password_hash")
    createdAt    DateTime     @map("created_at")
    updatedAt    DateTime?    @map("updated_at")

    @@index([tenantId])
    @@map("users")
}

model Sessions {
    id               String       @map("id")
    userId           String       @map("user_id")
    refreshTokenHash VarChar(253) @map("refresh_token_hash")
    expiresAt        DateTime     @map("expires_at")
    revokedAt        DateTime?    @map("revoked_at")
    createdAt        DateTime     @map("created_at")

    @@index([userId])
    @@index([refreshTokenHash])
    @@map("sessions")
}


model Tenants {
    id        String       @unique @map("id")
    name      VarChar(100) @map("name")
    slug      VarChar()    @unique @map("slug")
    createdAt DateTime     @map("created_at")
    updatedAt DateTime     @map("updated_at")

    @@map("tenants")
}