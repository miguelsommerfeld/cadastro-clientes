{
  "name": "@cadastro-clientes/api-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "dist/apps/api/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias --resolve-full-paths",
    "start": "node dist/apps/api/src/server.js",
    "seed": "DOTENV_CONFIG_PATH=../../.env tsx --import dotenv/config prisma/seed.ts",
    "test": "vitest run --coverage",
    "test:integration": "RUN_POSTGRES_INTEGRATION=1 vitest run test/integration --coverage.enabled=false"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-zod": "^1.0.0",
    "argon2": "^0.45.1",
    "cpf-cnpj-validator": "^2.1.2",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "install": "^0.13.0",
    "npm": "^12.2.0",
    "serve": "^10.0.2",
    "temporal-polyfill": "^1.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@prisma/config": "^6.12.0",
    "@prisma/orm-postgres": "^8.0.0-rc.14",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.1.0",
    "prisma": "^8.0.0-rc.20",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
